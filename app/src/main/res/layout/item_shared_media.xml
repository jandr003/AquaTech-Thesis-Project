<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="110dp"
    android:layout_height="110dp"
    android:layout_marginEnd="10dp"
    app:cardBackgroundColor="#F1F5F9"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivSharedMediaThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/maintenance_technician1" />

        <LinearLayout
            android:id="@+id/sharedMediaDocOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E2E8F0"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_pdf_document"
                app:tint="#2196F3" />

            <TextView
                android:id="@+id/tvSharedMediaName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="Document.pdf"
                android:textColor="#1E293B"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>