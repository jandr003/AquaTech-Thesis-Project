<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="2dp">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:alpha="0.8"
            android:scaleType="fitXY"
            android:src="@drawable/header_wave_overlay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp"
            app:layout_constraintTop_toTopOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/compLogoImg"
                    android:layout_width="210dp"
                    android:layout_height="58dp"
                    android:scaleType="fitStart"
                    android:src="@drawable/asc_logo_all_about_water" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="end"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safer Water,"
                        android:textColor="#2196F3"
                        android:textSize="16sp"
                        android:textStyle="bold|italic" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Healthier Tomorrow."
                        android:textColor="#2196F3"
                        android:textSize="16sp"
                        android:textStyle="bold|italic" />
                    <View
                        android:layout_width="50dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="4dp"
                        android:background="#2196F3" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SERVICE COMPLETED"
                        android:textColor="#1C4E75"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="32sp"
                        app:autoSizeStepGranularity="1sp"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Official Service Invoice &amp; Record"
                        android:textColor="#64748B"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_pdf_document"
                        app:tint="#2196F3" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reference No."
                            android:textColor="#64748B"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/compTicketId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SR-2026-0001"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_pdf_calendar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SERVICE DATE"
                            android:textColor="#64748B"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/compServiceDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="October 26, 2026"
                            android:textColor="#1E293B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/compServiceTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:45 AM"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="#E2E8F0" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Status"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/compStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_pdf_status_green_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="COMPLETED"
                        android:textColor="#166534"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_pdf_dot"
                        android:drawablePadding="8dp"
                        app:drawableTint="#166534" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_blue"
                            android:padding="8dp"
                            android:src="@drawable/ic_pdf_person" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="CUSTOMER DETAILS"
                            android:textColor="#1C4E75"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/lblC1"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:text="Name"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/compCustomerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/lblC1"
                            android:text="Juan Dela Cruz"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblC2"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblC1"
                            android:layout_marginTop="12dp"
                            android:text="Contact Number"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/compContact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblC1"
                            android:layout_marginTop="12dp"
                            android:layout_toEndOf="@id/lblC2"
                            android:text="0917 123 4567"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblC3"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblC2"
                            android:layout_marginTop="12dp"
                            android:text="Address"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/compAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblC2"
                            android:layout_marginTop="12dp"
                            android:layout_toEndOf="@id/lblC3"
                            android:text="123 Santos St., Brgy. San Miguel, Makati City"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_blue"
                            android:padding="8dp"
                            android:src="@drawable/ic_pdf_wrench" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="SERVICE FINDINGS"
                            android:textColor="#1C4E75"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/lblS1"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:text="Service Performed"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/compServiceDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/lblS1"
                            android:text="Unit Maintenance &amp; Cleaning"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblS2"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/compServiceDesc"
                            android:layout_marginTop="12dp"
                            android:text="Tech Remarks"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/compTechRemarks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/compServiceDesc"
                            android:layout_marginTop="12dp"
                            android:layout_toEndOf="@id/lblS2"
                            android:text="System is in optimal condition after filter replacement."
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/compOrdersContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/circle_blue"
                                android:padding="8dp"
                                android:src="@drawable/ic_pdf_card" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="PAYMENT SUMMARY"
                                android:textColor="#1C4E75"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/compPaymentBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_pdf_status_green_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="PAID"
                            android:textColor="#166534"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center_vertical"
                            app:drawableStartCompat="@drawable/ic_pdf_dot"
                            android:drawablePadding="6dp"
                            app:drawableTint="#166534" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/lblP1"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:text="Payment Method"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/compPaymentMethod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/lblP1"
                            android:text="GCash"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblP2"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblP1"
                            android:layout_marginTop="12dp"
                            android:text="Settled Amount"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/compTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblP1"
                            android:layout_marginTop="12dp"
                            android:layout_toEndOf="@id/lblP2"
                            android:text="₱ 2,500.00"
                            android:textColor="#166534"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblP3"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblP2"
                            android:layout_marginTop="12dp"
                            android:text="Collected By"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/compCollectedBy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblP2"
                            android:layout_marginTop="12dp"
                            android:layout_toEndOf="@id/lblP3"
                            android:text="Rafael Santos"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/compTechSign"
                            android:layout_width="140dp"
                            android:layout_height="60dp"
                            android:scaleType="fitCenter" />

                        <View
                            android:layout_width="140dp"
                            android:layout_height="1dp"
                            android:background="#CBD5E1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Technician Signature"
                            android:textColor="#64748B"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/compCustSign"
                            android:layout_width="140dp"
                            android:layout_height="60dp"
                            android:scaleType="fitCenter" />

                        <View
                            android:layout_width="140dp"
                            android:layout_height="1dp"
                            android:background="#CBD5E1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Customer Signature"
                            android:textColor="#64748B"
                            android:textSize="10sp" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="cursive"
                android:text="Technical Service Completed"
                android:textColor="#166534"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="This document serves as your official record of service.\nThank you for trusting AquaTech for your water safety needs."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_phone"
                        app:tint="#2196F3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Sales: +63 998 557 9144"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="16dp"
                        android:background="#CBD5E1"
                        android:layout_marginHorizontal="18dp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_phone"
                        app:tint="#2196F3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Technical: +63 998 961 9695"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>