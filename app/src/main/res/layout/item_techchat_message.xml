<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="12dp"
    android:paddingVertical="0dp">

    <TextView
        android:id="@+id/tvDateHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/poppins_black_ttf"
        android:text="Today"
        android:textColor="#8E8E8E"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSenderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDateHeader"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/poppins_black_ttf"
        android:text="Jhonny Sinder"
        android:textColor="#2563EB"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/techAvatarIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSenderLabel"
        android:layout_alignParentStart="true"
        android:layout_marginStart="4dp"
        android:background="@drawable/bubble_ai"
        android:maxWidth="290dp"
        android:minWidth="60dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black_ttf"
            android:lineSpacingExtra="3dp"
            android:text="Sample text..."
            android:textColor="#334155"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/fileAttachmentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="Attachment"
                android:src="@drawable/upload_file_png" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="@font/poppins_black_ttf"
                    android:singleLine="true"
                    android:text="Receipt.pdf"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_black_ttf"
                    android:text="2 MB"
                    android:textColor="#64748B"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btnDownloadAction"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Download"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_download"
                app:tint="#64748B" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="12:00 PM"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:visibility="gone" />

    </LinearLayout>
</RelativeLayout>
