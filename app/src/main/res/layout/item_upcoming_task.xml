<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/statusOpenGreen"
        android:layout_width="32dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/status_completed_green"
        android:fontFamily="@font/poppins_black_ttf"
        android:gravity="top|center_horizontal"
        android:lineSpacingExtra="0dp"
        android:paddingTop="6dp"
        android:text="26\nF\nE\nB"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/UpcomingCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/UpcomingCard" />

    <androidx.cardview.widget.CardView
        android:id="@+id/UpcomingCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#F8FAFC"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/statusOpenGreen"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvUpcomingCustomerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:text="Customer Name"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvUpcomingTicketId"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvUpcomingTicketId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="#ASC2026-0000"
                android:textColor="#2563EB"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvUpcomingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:text="00:00 AM - 00:00 PM"
                android:textColor="#64748B"
                android:textSize="11.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvUpcomingTicketId" />

            <TextView
                android:id="@+id/tvUpcomingServiceType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="Filter Preventive, Other Parts"
                android:textColor="#1C4E75"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvUpcomingTime"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvUpcomingCustomerName" />

            <TextView
                android:id="@+id/tvUpcomingAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="2"
                android:text="Address details will appear here..."
                android:textColor="#64748B"
                android:textSize="12.5sp"
                app:layout_constraintEnd_toStartOf="@+id/btnAcceptUpcoming"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvUpcomingServiceType" />

            <TextView
                android:id="@+id/tvUpcomingSro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins"
                android:text="SRO-00000000"
                android:textColor="#64748B"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvUpcomingAddress" />

            <ImageView
                android:id="@+id/btnChatUpcoming"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Chat with Customer"
                android:padding="8dp"
                android:src="@drawable/chat_1"
                app:layout_constraintBottom_toBottomOf="@+id/btnAcceptUpcoming"
                app:layout_constraintEnd_toStartOf="@+id/btnAcceptUpcoming"
                app:layout_constraintTop_toTopOf="@+id/btnAcceptUpcoming" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#2196F3"
                android:fontFamily="@font/poppins"
                android:paddingHorizontal="16dp"
                android:text="ACCEPT"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvUpcomingTime"
                app:layout_constraintVertical_bias="1.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
