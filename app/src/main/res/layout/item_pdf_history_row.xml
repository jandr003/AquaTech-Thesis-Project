<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/pdfRowTicket"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:singleLine="true"
            android:text="SRO-00004521"
            android:textColor="#1E293B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pdfRowCustomer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Juan Dela Cruz"
            android:textColor="#334155"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/pdfRowTech"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Jhonny Sinder"
            android:textColor="#334155"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/pdfRowUnit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.0"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:singleLine="true"
            android:text="WL Cube Firewall"
            android:textColor="#334155"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/pdfRowDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Oct 24, 2024"
            android:textColor="#334155"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/pdfRowStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:gravity="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Completed"
            android:textColor="#16A34A"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

</LinearLayout>
