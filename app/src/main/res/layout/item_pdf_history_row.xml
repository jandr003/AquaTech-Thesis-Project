<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="9dp">

        <TextView
            android:id="@+id/pdfRowTicket"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.0"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#1E293B"
            android:textSize="9.5sp"
            android:textStyle="bold"
            tools:text="SRO-00004521" />

        <TextView
            android:id="@+id/pdfRowCustomer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#334155"
            android:textSize="9.5sp"
            tools:text="Customer Name" />

        <TextView
            android:id="@+id/pdfRowTech"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#334155"
            android:textSize="9.5sp"
            tools:text="Technician Name" />

        <TextView
            android:id="@+id/pdfRowDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#334155"
            android:textSize="9.5sp"
            tools:text="Service Date" />

        <TextView
            android:id="@+id/pdfRowStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:gravity="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#16A34A"
            android:textSize="9.5sp"
            android:textStyle="bold"
            tools:text="Completed" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

</LinearLayout>
