<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <FrameLayout
        android:id="@+id/notificationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/techBottomNav"
        app:layout_constraintTop_toBottomOf="@id/notificationContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <View
                android:id="@+id/headerBg"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:background="#2196F3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.05" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.95" />

            <FrameLayout
                android:id="@+id/techAvatarFrame"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/circle_white"
                android:padding="2dp"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/techProfileAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Technician Profile Avatar"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/new_technician" />

            </FrameLayout>


            <TextView
                android:id="@+id/TechnicianDash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:text="Good Day, Technician!"
                android:textColor="@color/white"
                android:textSize="18.5sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/techAvatarFrame"
                app:layout_constraintEnd_toStartOf="@+id/topIconsLayout"
                app:layout_constraintStart_toEndOf="@id/techAvatarFrame"
                app:layout_constraintTop_toTopOf="@id/techAvatarFrame" />

            <LinearLayout
                android:id="@+id/topIconsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/techAvatarFrame"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintTop_toTopOf="@id/techAvatarFrame">

                <ImageView
                    android:id="@+id/notifIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Notifications"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/notification_icon"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/settingIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Settings"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/settingicon"
                    app:tint="@color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/SchedService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins_black_ttf"
                android:letterSpacing="0.03"
                android:text="Scheduled Services"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/techAvatarFrame" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/TechnicianCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="280dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/SchedService"
                app:layout_constraintWidth_max="700dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:id="@+id/noTicketsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:contentDescription="No Tickets"
                            android:src="@drawable/send_1"
                            app:tint="#CBD5E1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/poppins"
                            android:text="No assigned tasks yet"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProgressLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_black_ttf"
                        android:text="IN PROGRESS"
                        android:textColor="#1C4E75"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvProgressCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/poppins"
                        android:text="(1)"
                        android:textColor="#1C4E75"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvProgressLabel"
                        app:layout_constraintStart_toEndOf="@id/tvProgressLabel" />

                    <View
                        android:id="@+id/underlineProgress"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="18dp"
                        android:background="#E2E8F0"
                        app:layout_constraintBottom_toBottomOf="@id/tvProgressLabel"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvProgressCount"
                        app:layout_constraintTop_toTopOf="@id/tvProgressLabel" />

                    <TextView
                        android:id="@+id/statusOpenBlue"
                        android:layout_width="28dp"
                        android:layout_height="120dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/status_in_progress_blue"
                        android:fontFamily="@font/poppins_black_ttf"
                        android:gravity="top|center_horizontal"
                        android:lineSpacingExtra="0dp"
                        android:paddingTop="6dp"
                        android:text="12\nD\nE\nC\nE\nM\nB\nE\nR"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvProgressLabel" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/TechnicianReportOne"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="52dp"
                        android:layout_marginEnd="16dp"
                        app:cardBackgroundColor="#F8FAFC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/statusOpenBlue">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvReportLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/poppins"
                                android:maxLines="1"
                                android:text="Customer Name"
                                android:textColor="#1E293B"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toStartOf="@+id/displayTicketID"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/displayTicketID"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="#ASC2026-0001"
                                android:textColor="#2563EB"
                                android:textSize="13.5sp"
                                android:textStyle="bold"
                                app:layout_constraintBaseline_toBaselineOf="@id/tvReportLabel"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <TextView
                                android:id="@+id/tvReportSubLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/poppins"
                                android:text="SERVICE TYPE"
                                android:textColor="#1C4E75"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvReportLabel" />

                            <TextView
                                android:id="@+id/displayTimeRequest"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="TIME RANGE"
                                android:textColor="#64748B"
                                android:textSize="11.5sp"
                                app:layout_constraintBaseline_toBaselineOf="@+id/tvReportSubLabel"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <TextView
                                android:id="@+id/tvcustomerAddress"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/poppins"
                                android:maxLines="2"
                                android:text="Address Details"
                                android:textColor="#64748B"
                                android:textSize="12.5sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvReportSubLabel" />

                            <TextView
                                android:id="@+id/customerSroNum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/poppins"
                                android:text="SRO-0000"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvcustomerAddress" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/submitButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginTop="10dp"
                                android:backgroundTint="#2196F3"
                                android:fontFamily="@font/poppins"
                                android:paddingHorizontal="16dp"
                                android:text="TRACK"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvcustomerAddress" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvUpcomingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="22dp"
                        android:fontFamily="@font/poppins_black_ttf"
                        android:text="UPCOMING TASKS"
                        android:textColor="#1C4E75"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/TechnicianReportOne" />

                    <TextView
                        android:id="@+id/tvUpcomingLabelCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/poppins"
                        android:text="(0)"
                        android:textColor="#1C4E75"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tvUpcomingLabel"
                        app:layout_constraintStart_toEndOf="@+id/tvUpcomingLabel" />

                    <View
                        android:id="@+id/UpcomingProgress"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="18dp"
                        android:background="#E2E8F0"
                        app:layout_constraintBottom_toBottomOf="@+id/tvUpcomingLabel"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvUpcomingLabelCount"
                        app:layout_constraintTop_toTopOf="@+id/tvUpcomingLabel" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvUpcomingTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        app:layout_constraintTop_toBottomOf="@id/tvUpcomingLabel"
                        tools:listitem="@layout/item_upcoming_task" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/techBottomNav"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/white"
        app:elevation="12dp"
        app:itemActiveIndicatorStyle="@style/BottomNavActiveIndicator"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemPaddingBottom="1dp"
        app:itemPaddingTop="8dp"
        app:itemRippleColor="#E0F2FE"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/tech_bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
