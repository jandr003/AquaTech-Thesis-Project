<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="2dp">

        <!-- Outer Frame / Border -->
        <View
            android:id="@+id/pdfMainFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_card_premium_outline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top Decorative Wave -->
        <ImageView
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:alpha="0.8"
            android:scaleType="fitXY"
            android:src="@drawable/header_wave_overlay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- HEADER SECTION -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Logo using official PNG asset -->
                <ImageView
                    android:id="@+id/pdfLogoImg"
                    android:layout_width="190dp"
                    android:layout_height="52dp"
                    android:scaleType="fitStart"
                    android:src="@drawable/asc_logo_all_about_water" />

                <!-- Corporate Slogan (Right Aligned) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safer Water,"
                        android:textColor="#3DAADB"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Healthier Tomorrow."
                        android:textColor="#3DAADB"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                    <View
                        android:layout_width="45dp"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="4dp"
                        android:background="#3DAADB" />
                </LinearLayout>
            </RelativeLayout>

            <!-- TITLE SECTION (Responsive Single Line Prevention) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Weighted Title Container to ensure full visibility without overlap -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SERVICE REQUEST"
                        android:textColor="#1C4E75"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="32sp"
                        app:autoSizeStepGranularity="1sp"
                        android:maxLines="1"
                        android:gravity="start|center_vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Request Summary"
                        android:textColor="#64748B"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Request ID Badge Pill (Fixed position to the right) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_pdf_document"
                        app:tint="#3DAADB" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Request No."
                            android:textColor="#64748B"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/pdfTicketId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SR-2026-0001"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- META DATA ROW (Timestamps & Status) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_pdf_calendar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Submitted"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/pdfSubmittedTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sep 18, 2026 • 4:32 PM"
                            android:textColor="#1E293B"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="#E2E8F0" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_pdf_calendar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Preferred Schedule"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/pdfScheduleSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sep 19, 2026 • Morning"
                            android:textColor="#1E293B"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="#E2E8F0" />

                <!-- STATUS BADGE (Styled exactly like 2nd image) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textColor="#64748B"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/pdfStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_pdf_status_pending_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="PENDING"
                        android:textColor="#D97706"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_pdf_dot"
                        android:drawablePadding="6dp"
                        app:drawableTint="#D97706" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/circle_blue"
                            android:padding="6dp"
                            android:src="@drawable/ic_pdf_person" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="CUSTOMER DETAILS"
                            android:textColor="#1C4E75"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView android:id="@+id/l1" android:layout_width="140dp" android:layout_height="wrap_content" android:text="Name" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfCustomerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/l1" android:text="Juan Dela Cruz" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />

                        <TextView android:id="@+id/l2" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_below="@id/l1" android:layout_marginTop="10dp" android:text="Contact Number" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfContact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/l1" android:layout_marginTop="10dp" android:layout_toEndOf="@id/l2" android:text="0917 123 4567" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />

                        <TextView android:id="@+id/l3" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_below="@id/l2" android:layout_marginTop="10dp" android:text="Address" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/l2" android:layout_marginTop="10dp" android:layout_toEndOf="@id/l3" android:text="123 Santos St., Brgy. San Miguel, Makati City, Metro Manila" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/circle_blue"
                            android:padding="6dp"
                            android:src="@drawable/ic_pdf_house" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="UNIT INFORMATION"
                            android:textColor="#1C4E75"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView android:id="@+id/u1" android:layout_width="140dp" android:layout_height="wrap_content" android:text="Product" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/u1" android:text="AquaTal" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />

                        <TextView android:id="@+id/u2" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_below="@id/u1" android:layout_marginTop="10dp" android:text="Unit Code" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfUnitCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/u1" android:layout_marginTop="10dp" android:layout_toEndOf="@id/u2" android:text="AT-001245" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />

                        <TextView android:id="@+id/u3" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_below="@id/u2" android:layout_marginTop="10dp" android:text="Installation Location" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/u2" android:layout_marginTop="10dp" android:layout_toEndOf="@id/u3" android:text="Building A - 3rd Floor" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/circle_blue"
                            android:padding="6dp"
                            android:src="@drawable/ic_pdf_wrench" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="SERVICE DETAILS"
                            android:textColor="#1C4E75"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView android:id="@+id/s1" android:layout_width="140dp" android:layout_height="wrap_content" android:text="Service Type" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfServiceType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/s1" android:text="Maintenance" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />

                        <TextView android:id="@+id/s2" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_below="@id/s1" android:layout_marginTop="10dp" android:text="Description" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/s1" android:layout_marginTop="10dp" android:layout_toEndOf="@id/s2" android:text="Water Quality Check &amp; Maintenance" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />

                        <TextView android:id="@+id/s3" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_below="@id/s2" android:layout_marginTop="10dp" android:text="Concern" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfConcern" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/s2" android:layout_marginTop="10dp" android:layout_toEndOf="@id/s3" android:text="Filter replacement recommended." android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />

                        <TextView android:id="@+id/s4" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_below="@id/s3" android:layout_marginTop="10dp" android:text="Remarks" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfRemarks" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/s3" android:layout_marginTop="10dp" android:layout_toEndOf="@id/s4" android:text="Customer reported reduced water flow." android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/pdfOrdersContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/circle_blue"
                                android:padding="6dp"
                                android:src="@drawable/ic_pdf_card" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="PAYMENT"
                                android:textColor="#1C4E75"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Payment Status"
                                android:textColor="#64748B"
                                android:textSize="10sp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/pdfPaymentStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pdf_status_blue_pill"
                                app:drawableStartCompat="@drawable/ic_pdf_clock"
                                android:drawablePadding="6dp"
                                app:drawableTint="#2563EB"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="FOR VERIFICATION"
                                android:textColor="#2563EB"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView android:id="@+id/p1" android:layout_width="140dp" android:layout_height="wrap_content" android:text="Payment Method" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfPaymentMethod" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/p1" android:text="GCash" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />

                        <TextView android:id="@+id/p2" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_below="@id/p1" android:layout_marginTop="10dp" android:text="Amount" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/pdfTotalAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/p1" android:layout_marginTop="10dp" android:layout_toEndOf="@id/p2" android:text="₱ 2,500.00" android:textColor="#2563EB" android:textSize="16sp" android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_pdf_card_light"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/circle_blue"
                            android:padding="6dp"
                            android:src="@drawable/ic_pdf_person" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="ASSIGNMENT"
                            android:textColor="#1C4E75"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Technician" android:textColor="#64748B" android:textSize="13sp" />
                            <TextView android:id="@+id/pdfTechName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Not yet assigned" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/pdfTechSignature"
                            android:layout_width="140dp"
                            android:layout_height="50dp"
                            android:layout_alignParentEnd="true"
                            android:scaleType="fitCenter" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="cursive"
                        android:text="Thank you!"
                        android:textColor="#3DAADB"
                        android:textSize="32sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="For choosing AquaTech!\nWe're committed to keeping your water safe and clean."
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>


            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_phone" app:tint="#3DAADB" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="(02) 8888 1234" android:textColor="#64748B" android:textSize="10sp" />

                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="20dp" android:src="@drawable/ic_message" app:tint="#3DAADB" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="support@aquatech.ph" android:textColor="#64748B" android:textSize="10sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/ic_pinpoint"
                    app:tint="#3DAADB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
