<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSuccessRoot"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardUseCompatPadding="true"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <ImageView
                android:id="@+id/ivSuccessIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="Success Check"
                android:src="@drawable/ic_completed"
                app:tint="#4CAF50" />

            <TextView
                android:id="@+id/tvReportSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_black_ttf"
                android:letterSpacing="0.03"
                android:text="REPORT SUBMITTED"
                android:textColor="#1C4E75"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportSuccessSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:text="Pending Admin Review"
                android:textColor="#4CAF50"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportSuccessMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="18dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Your report has been submitted and is pending admin approval."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoneReportSuccess"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="#2196F3"
                android:fontFamily="@font/poppins"
                android:text="GOT IT"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:elevation="2dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
