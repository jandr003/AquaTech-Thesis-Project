<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconBg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="#EBF5FF"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivHistoryIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Service Icon"
                android:padding="10dp"
                android:src="@drawable/ic_pdf_wrench"
                app:tint="#2196F3" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvHistoryTicketId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/poppins"
            android:text="#ASC2026-0146"
            android:textColor="#2563EB"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvHistoryPrice"
            app:layout_constraintStart_toEndOf="@id/iconBg"
            app:layout_constraintTop_toTopOf="@id/iconBg" />

        <TextView
            android:id="@+id/tvHistoryPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="₱ 2,500.00"
            android:textColor="#10B981"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/iconBg" />

        <TextView
            android:id="@+id/tvHistoryItems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:text="Installation Kit, Filter Preventive..."
            android:textColor="#1E293B"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvHistoryStatus"
            app:layout_constraintStart_toStartOf="@id/tvHistoryTicketId"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryTicketId" />

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins"
            android:text="August 28, 2025 • 10:30 PM"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            app:layout_constraintEnd_toStartOf="@id/tvHistoryStatus"
            app:layout_constraintStart_toStartOf="@id/tvHistoryItems"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryItems" />

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pdf_status_green_pill"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="● COMPLETED"
            android:textColor="#059669"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryPrice" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
