<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- TOP NAVIGATION -->
    <ImageView
        android:id="@+id/ExitIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#0F172A" />

    <TextView
        android:id="@+id/tvTopTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_black_ttf"
        android:text="Service Request"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ExitIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ExitIcon" />

    <!-- NEED HELP (NO ICON) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnNeedHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#F0F9FF"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/ExitIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ExitIcon">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:fontFamily="@font/poppins_black_ttf"
            android:text="Need help?"
            android:textColor="#0284C7"
            android:textSize="12sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- STEPPER LAYOUT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stepperContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTopTitle">

        <View android:id="@+id/line1" android:layout_width="0dp" android:layout_height="2dp" android:background="#3DAADB" app:layout_constraintBottom_toBottomOf="@id/circleNumber1" app:layout_constraintEnd_toStartOf="@id/circleNumber2" app:layout_constraintStart_toEndOf="@id/circleNumber1" app:layout_constraintTop_toTopOf="@id/circleNumber1" />
        <View android:id="@+id/line2" android:layout_width="0dp" android:layout_height="2dp" android:background="#E2E8F0" app:layout_constraintBottom_toBottomOf="@id/circleNumber2" app:layout_constraintEnd_toStartOf="@id/circleNumber3" app:layout_constraintStart_toEndOf="@id/circleNumber2" app:layout_constraintTop_toTopOf="@id/circleNumber2" />
        <View android:id="@+id/line3" android:layout_width="0dp" android:layout_height="2dp" android:background="#E2E8F0" app:layout_constraintBottom_toBottomOf="@id/circleNumber3" app:layout_constraintEnd_toStartOf="@id/circleNumber4" app:layout_constraintStart_toEndOf="@id/circleNumber3" app:layout_constraintTop_toTopOf="@id/circleNumber3" />

        <androidx.cardview.widget.CardView android:id="@+id/circleNumber1" android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="#3DAADB" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:layout_constraintEnd_toStartOf="@id/circleNumber2" app:layout_constraintHorizontal_chainStyle="spread" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"><TextView android:id="@+id/circleText1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="✓" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" /></androidx.cardview.widget.CardView>
        <TextView android:id="@+id/label1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/poppins" android:text="Request" android:textColor="#3DAADB" android:textSize="12sp" app:layout_constraintEnd_toEndOf="@id/circleNumber1" app:layout_constraintStart_toStartOf="@id/circleNumber1" app:layout_constraintTop_toBottomOf="@id/circleNumber1" />

        <androidx.cardview.widget.CardView android:id="@+id/circleNumber2" android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="#3DAADB" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:layout_constraintEnd_toStartOf="@id/circleNumber3" app:layout_constraintStart_toEndOf="@id/circleNumber1" app:layout_constraintTop_toTopOf="parent"><TextView android:id="@+id/circleText2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="2" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" /></androidx.cardview.widget.CardView>
        <TextView android:id="@+id/label2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/poppins" android:text="Schedule" android:textColor="#3DAADB" android:textSize="12sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="@id/circleNumber2" app:layout_constraintStart_toStartOf="@id/circleNumber2" app:layout_constraintTop_toBottomOf="@id/circleNumber2" />

        <androidx.cardview.widget.CardView android:id="@+id/circleNumber3" android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="#E2E8F0" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:layout_constraintEnd_toStartOf="@id/circleNumber4" app:layout_constraintStart_toEndOf="@id/circleNumber2" app:layout_constraintTop_toTopOf="parent"><TextView android:id="@+id/circleText3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="3" android:textColor="#94A3B8" android:textSize="14sp" /></androidx.cardview.widget.CardView>
        <TextView android:id="@+id/label3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/poppins" android:text="Item" android:textColor="#94A3B8" android:textSize="12sp" app:layout_constraintEnd_toEndOf="@id/circleNumber3" app:layout_constraintStart_toStartOf="@id/circleNumber3" app:layout_constraintTop_toBottomOf="@id/circleNumber3" />

        <androidx.cardview.widget.CardView android:id="@+id/circleNumber4" android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="#E2E8F0" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/circleNumber3" app:layout_constraintTop_toTopOf="parent"><TextView android:id="@+id/circleText4" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="4" android:textColor="#94A3B8" android:textSize="14sp" /></androidx.cardview.widget.CardView>
        <TextView android:id="@+id/label4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/poppins" android:text="Payment" android:textColor="#94A3B8" android:textSize="12sp" app:layout_constraintEnd_toEndOf="@id/circleNumber4" app:layout_constraintStart_toStartOf="@id/circleNumber4" app:layout_constraintTop_toBottomOf="@id/circleNumber4" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENT SCROLL AREA -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/stepperContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">

            <!-- STEP 2 HEADER BOX -->
            <androidx.cardview.widget.CardView
                android:id="@+id/step2InfoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="#F0F9FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_step_schedule"
                            app:tint="#0284C7" />

                    </androidx.cardview.widget.CardView>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black_ttf" android:text="2. Schedule" android:textColor="#0F172A" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins" android:text="Choose your preferred schedule and service type." android:textColor="#64748B" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STEP 2 FORM FIELDS -->
            <LinearLayout
                android:id="@+id/step2FormContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/step2InfoBox">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins" android:text="Preferred Date" android:textColor="#475569" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input_field" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_today" app:tint="#94A3B8" />
                    <TextView android:id="@+id/displayDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:fontFamily="@font/poppins" android:textColor="#0F172A" android:textSize="15sp" tools:text="January 15, 2026" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_today" app:tint="#94A3B8" />
                </LinearLayout>

                <TextView android:id="@+id/serviceTimeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:fontFamily="@font/poppins" android:text="Preferred Time" android:textColor="#475569" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input_field" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_time_history" app:tint="#94A3B8" />
                    <TextView android:id="@+id/startTimeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="@font/poppins" android:textColor="#0F172A" android:textSize="15sp" tools:text="10:00 AM" />
                    <TextView android:id="@+id/toLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" - " android:textColor="#0F172A" />
                    <TextView android:id="@+id/endTimeText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/poppins" android:textColor="#0F172A" android:textSize="15sp" tools:text="12:00 PM" />
                    <ImageView android:id="@+id/startTimeArrow" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/arrow_down_float" app:tint="#94A3B8" />
                </LinearLayout>

                <TextView android:id="@+id/purchaseTypeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:fontFamily="@font/poppins" android:text="Type of Purchase" android:textColor="#475569" android:textSize="14sp" android:textStyle="bold" />

                <!-- PURCHASE TYPE SELECTION (Professional Shadow Fix) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipToPadding="false"
                        android:clipChildren="false">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSubscription"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_margin="6dp"
                            android:background="@drawable/button_blue_rounded"
                            android:elevation="6dp"
                            android:translationZ="3dp"
                            android:fontFamily="@font/poppins"
                            android:text="Subscription"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnOutright"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_margin="6dp"
                            android:background="@drawable/bg_input_field"
                            android:elevation="6dp"
                            android:translationZ="3dp"
                            android:fontFamily="@font/poppins"
                            android:text="Outright"
                            android:textAllCaps="false"
                            android:textColor="#475569"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipToPadding="false"
                        android:clipChildren="false">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnOccular"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_margin="6dp"
                            android:background="@drawable/bg_input_field"
                            android:elevation="6dp"
                            android:translationZ="3dp"
                            android:fontFamily="@font/poppins"
                            android:text="Occular"
                            android:textAllCaps="false"
                            android:textColor="#475569"
                            android:textSize="14sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:layout_margin="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- INFO BOX -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/purchaseInfoBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#F0F9FF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_dialog_info" app:tint="#0284C7" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvInfoTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins" android:text="Subscription" android:textColor="#0284C7" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvInfoDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins" android:text="Your service will be automatically renewed based on your chosen plan." android:textColor="#64748B" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NEXT BUTTON -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonNext2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_blue_rounded"
            android:fontFamily="@font/poppins_black_ttf"
            android:text="Next  →"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- HIDDEN LOGIC ELEMENTS (MUST REMAIN FOR JAVA CODE) -->
    <View android:id="@+id/UnderLine" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <View android:id="@+id/underline2" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <View android:id="@+id/underline3" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <View android:id="@+id/CompleteUnderline" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <!-- STEP 1 ELEMENTS (Hidden) -->
    <androidx.cardview.widget.CardView android:id="@+id/step1InfoBox" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/step1FormContainer" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/customerLabel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/customerNumber" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/customerAddress" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <EditText android:id="@+id/etCustomerNumber" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" tools:ignore="TextFields" />
    <EditText android:id="@+id/etCustomerAddress" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" tools:ignore="TextFields" />
    <EditText android:id="@+id/remarksInput" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" tools:ignore="TextFields" />
    <TextView android:id="@+id/tvCustomerNameValue" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:id="@+id/buttonNext" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

    <!-- OTHER STEP HELPERS -->
    <ImageView android:id="@+id/EditPen1" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/EditPen2" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/customerUnderline" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/customerUnderline2" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/customerUnderline3" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/customerRefNum" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/tvCustomerRefValue" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/customerUnderline4" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/customerDate" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/customerUnderline5" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/startTimeUnderline" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/endTimeUnderline" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/serviceEndTimeRow" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/purchaseTypeDropdown" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/customerValidIdLabel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <androidx.cardview.widget.CardView android:id="@+id/customerCard" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/imgPreview" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/imgPlaceHolder" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/takePhotoOrUpload" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
