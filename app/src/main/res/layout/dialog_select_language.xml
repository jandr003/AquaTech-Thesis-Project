<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivLogoHeader"
            android:layout_width="140dp"
            android:layout_height="70dp"
            android:contentDescription="AquaTech Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/asc_logooo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins"
            android:text="Language Preferences"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogoHeader" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins"
            android:text="Select your preferred application language"
            android:textColor="#64748B"
            android:textSize="12.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <View
            android:id="@+id/dividerLang"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#E2E8F0"
            app:layout_constraintTop_toBottomOf="@id/tvDesc" />

        <RadioGroup
            android:id="@+id/rgLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/dividerLang">

            <RadioButton
                android:id="@+id/rbEnglish"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="#2196F3"
                android:checked="true"
                android:fontFamily="@font/poppins"
                android:text="English (United States)"
                android:textColor="#1E293B"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbTagalog"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="#2196F3"
                android:fontFamily="@font/poppins"
                android:text="Tagalog / Filipino"
                android:textColor="#1E293B"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbTaglish"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="#2196F3"
                android:fontFamily="@font/poppins"
                android:text="Taglish (Filipino English)"
                android:textColor="#1E293B"
                android:textSize="14.5sp"
                android:textStyle="bold" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveLanguage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2196F3"
            android:fontFamily="@font/poppins"
            android:text="Save Language"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/rgLanguages" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
